# GitHub Pages project site. Leave empty for Vercel or local dev (served at /).
NEXT_PUBLIC_BASE_PATH=

# Canonical origin, including the base path when there is one.
# Pages: https://akhilsingh2.github.io/portfolio
# Vercel or a custom domain: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional contact form. Set one of these. If both are empty, the form opens a mailto.
# Formspree (or any endpoint that accepts a POST of name, email, message):
NEXT_PUBLIC_FORM_ENDPOINT=
# Or a Web3Forms access key:
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
